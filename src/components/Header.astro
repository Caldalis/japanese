---
import { site, url } from '../site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const nav = [
  { href: url('/kana/'), label: '五十音', match: '/kana/' },
  { href: url('/vocab/'), label: '词汇', match: '/vocab/' },
  { href: url('/grammar/'), label: '语法', match: '/grammar/' },
  { href: url('/notes/'), label: '笔记', match: '/notes/' },
];
const active = (m: string) => path.includes(m);
---
<header class="sticky z-30 bg-surface/90 backdrop-blur border-b border-line" style="top: env(safe-area-inset-top, 0px)">
  <div class="gutter max-w-5xl mx-auto h-14 flex items-center gap-4">
    <a href={url('/')} class="flex items-center gap-2.5 no-underline text-fg shrink-0">
      <span class="ja grid place-items-center w-8 h-8 rounded-lg bg-hira text-on-accent text-lg leading-none" aria-hidden="true">あ</span>
      <span class="font-semibold tracking-wide max-[440px]:hidden">{site.name}</span>
    </a>
    <nav class="flex items-center gap-1 text-sm" aria-label="主导航">
      {nav.map((n) => (
        <a href={n.href} aria-current={active(n.match) ? 'page' : undefined}
          class:list={['px-2.5 sm:px-3 py-1.5 rounded-lg no-underline whitespace-nowrap shrink-0 transition-colors', active(n.match) ? 'bg-hira-soft text-hira font-medium' : 'text-muted hover:text-fg hover:bg-raised']}>{n.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a href={site.repo} target="_blank" rel="noopener" aria-label="GitHub 仓库" title="GitHub" class="grid place-items-center w-9 h-9 rounded-lg text-muted hover:text-fg hover:bg-raised">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

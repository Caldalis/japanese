---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site';
import { LEVELS, STAGES } from '../../data/grammar';
const all = (await getCollection('grammar')).sort((a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order);
const count = (level: string) => {
  const stages = STAGES.filter((s) => s.level === level);
  const written = all.filter((n) => stages.some((s) => s.n === n.data.stage)).length;
  const planned = stages.reduce((sum, s) => sum + (s.planned?.length ?? 0), 0);
  return { written, total: written + planned, units: stages.length };
};
const totalWritten = all.length;
const totalAll = LEVELS.reduce((s, l) => s + count(l.id).total, 0);
---
<Base title="语法" description="N5 到 N2 共 40 个单元的日语语法路线，每条有规则表、例句朗读、中国人易错点和练习。" wide>
  <h1 class="text-xl font-semibold">语法</h1>
  <p class="text-muted text-sm mt-1 max-w-[42em]">路线从 N5 排到 N2，共 {STAGES.length} 个单元，从第一条开始往下学。每条都讲透：是什么、怎么变、例句能点着听、中国人在哪里容易错、最后练三句。</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {LEVELS.map((l) => { const c = count(l.id); return (
      <a href={`#${l.id}`} class="flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-sm no-underline text-fg hover:border-accent">
        <span class="font-medium">{l.id}</span>
        <span class="text-muted tabular-nums">{c.written} / {c.total}</span>
      </a>
    ); })}
    <span class="ml-auto self-center text-xs text-muted tabular-nums">已写 {totalWritten} 条，规划 {totalAll} 条</span>
  </div>

  {LEVELS.map((l) => { const c = count(l.id); const pct = c.total ? Math.round((c.written / c.total) * 100) : 0; return (
    <section id={l.id} class="mt-12 scroll-mt-20">
      <div class="flex items-baseline gap-3 flex-wrap">
        <h2 class="text-xl font-semibold">{l.title}</h2>
        <span class="text-sm text-muted tabular-nums">{c.units} 个单元 · {c.written} / {c.total} 条</span>
      </div>
      <p class="text-muted text-sm mt-1 max-w-[42em]">{l.goal}</p>
      <div class="mt-2 h-1.5 w-full max-w-[42em] rounded-full bg-raised overflow-hidden" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100" aria-label={`${l.id} 进度`}><div class="h-full bg-accent" style={`width:${pct}%`}></div></div>

      {STAGES.filter((s) => s.level === l.id).map((s) => { const notes = all.filter((n) => n.data.stage === s.n); const open = notes.length > 0; return (
        <section class="mt-7">
          <div class="flex items-baseline gap-3">
            <span class="text-xs text-muted tabular-nums tracking-wide">第 {s.n} 单元</span>
            <h3 class="text-base font-semibold">{s.title}</h3>
            {!open && <span class="text-[11px] px-2 py-0.5 rounded-full bg-raised text-muted">规划中</span>}
          </div>
          <p class="text-muted text-sm mt-1 max-w-[42em]">{s.desc}</p>
          {open && (
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {notes.map((n, i) => (
                <a href={url(`/grammar/${n.id}/`)} class="block rounded-2xl border border-line bg-surface p-4 no-underline text-fg hover:border-accent transition-colors">
                  <div class="flex items-center gap-2 text-xs text-muted tabular-nums"><span>{s.n}.{i + 1}</span><span class="ml-auto px-1.5 py-0.5 rounded bg-raised">{n.data.level}</span></div>
                  <div class="ja text-hira text-lg mt-1 leading-snug" lang="ja">{n.data.pattern}</div>
                  <div class="font-medium mt-1">{n.data.title}</div>
                  <p class="text-sm text-muted mt-1">{n.data.description}</p>
                </a>
              ))}
            </div>
          )}
          {s.planned && s.planned.length > 0 && (
            <ul class="mt-2.5 flex flex-wrap gap-1.5 text-[13px] text-muted">
              {s.planned.map((p) => <li class="rounded-lg border border-dashed border-line px-2.5 py-1 ja" lang="ja">{p}</li>)}
            </ul>
          )}
        </section>
      ); })}
    </section>
  ); })}
</Base>

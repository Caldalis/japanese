---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site';
import DueCount from '../../components/react/DueCount';
const decks = (await getCollection('vocab')).sort((a, b) => a.data.order - b.data.order);
const levels = [...new Set(decks.map((d) => d.data.level))];
const total = decks.reduce((s, d) => s + d.data.words.length, 0);
const forDue = decks.map((d) => ({ id: d.id, words: d.data.words.map((w) => w[0]) }));
---
<Base title="词汇" description="按主题分组的日语词表，每个词带读音、例句和音频，闪卡加间隔复习，进度存在本机。" wide>
  <h1 class="text-xl font-semibold">词汇</h1>
  <p class="text-muted text-sm mt-1 max-w-[42em]">按主题分组，每个词都有读音、例句和音频。用闪卡学，系统按你的记忆情况安排复习时间。进度只存在这台设备的浏览器里。</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="text-sm text-muted tabular-nums">{decks.length} 组 · {total} 词</span>
    <DueCount client:load decks={forDue} />
  </div>
  {levels.map((lv) => (
    <section class="mt-8">
      <h2 class="text-lg font-semibold">{lv}</h2>
      <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {decks.filter((d) => d.data.level === lv).map((d) => (
          <a href={url(`/vocab/${d.id}/`)} class="block min-w-0 rounded-2xl border border-line bg-surface p-4 no-underline text-fg hover:border-accent transition-colors">
            <div class="flex items-center gap-2"><span class="font-medium">{d.data.title}</span><span class="ml-auto text-xs text-muted tabular-nums">{d.data.words.length} 词</span></div>
            <p class="mt-1 text-sm text-muted">{d.data.desc}</p>
            <p class="ja mt-2 text-hira text-sm truncate" lang="ja">{d.data.words.slice(0, 6).map((w) => w[0]).join('　')}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <div class="note">中国人背日语词的要点：汉字词一看就懂，只需要练读音；和语词（没有汉字或训读的词）才要练意思。闪卡的"听音"模式只放读音不显示字，专门练听力。</div>
</Base>

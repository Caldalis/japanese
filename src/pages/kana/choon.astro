---
import Base from '../../layouts/Base.astro';
import KanaNav from '../../components/KanaNav.astro';
import { CHOON, isHira } from '../../data/kana';
---
<Base title="长音·促音" description="长音、促音和长短对比。日语按拍计时，拖不拖决定意思。">
  <KanaNav />
  <h1 class="text-xl font-semibold">长音·促音</h1>
  <p class="text-muted text-sm mt-1">日语按“拍”计时，长音就是把元音拖成两拍。拖不拖决定意思：おばさん 阿姨，おばあさん 奶奶。点词听长短。</p>
  {CHOON.map((rule) => (
    <section class="mt-6">
      <h2 class="font-semibold">{rule.title}</h2>
      <p class="text-muted text-sm mb-2">{rule.note}</p>
      <div class="grid gap-1.5">
        {rule.examples.map((e) => (
          <button type="button" class="ex" data-say={e.word}>
            <span class:list={['w', { kata: !isHira(e.word) }]}>{e.word}</span>
            <span class="m"><b>{e.romaji}</b>{e.meaning}</span>
            <span class="text-accent text-sm">▶</span>
          </button>
        ))}
      </div>
    </section>
  ))}
</Base>

---
import Base from '../../layouts/Base.astro';
import KanaNav from '../../components/KanaNav.astro';
import KanaGrid from '../../components/react/KanaGrid';
---
<Base title="五十音 清音" description="46 个清音假名的汉字字源、读音和记法。点任何一个假名听读音、看字源。">
  <KanaNav />
  <h1 class="text-xl font-semibold">清音</h1>
  <p class="text-muted text-sm mt-1 mb-3">点任何一个假名：听读音，看它是哪个汉字变来的。点行首的 ▶ 整行连读，跟着念出节奏。</p>
  <KanaGrid client:load />
  <div class="note">表里共 46 个字。“五十”是按 5 段 × 10 行的格子算的，ゐ ゑ 已废。读音例外：し shi、ち chi、つ tsu、ふ fu；助词 は 读 wa、へ 读 e、を 读 o。</div>
</Base>

---
import Base from '../../layouts/Base.astro';
import KanaNav from '../../components/KanaNav.astro';
import DakuonGrid from '../../components/react/DakuonGrid';
---
<Base title="浊音·拗音" description="浊音、半浊音和拗音的规则与读音。它们不是新字。">
  <KanaNav />
  <h1 class="text-xl font-semibold">浊音·半浊音</h1>
  <p class="text-muted text-sm mt-1 mb-2">不是新字。右上角两点 ゛ 叫浊点，让 k s t h 变成 g z d b；小圆圈 ゜ 叫半浊点，只用在 は行，变成 p。点格子听读音。</p>
  <DakuonGrid client:load />
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site';
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title="笔记" description="学习方法、字源来历和之后的语法笔记。">
  <h1 class="text-xl font-semibold">笔记</h1>
  <p class="text-muted text-sm mt-1 mb-4">每篇是仓库里的一个 Markdown 文件，改了就更新。</p>
  <div class="grid gap-3">
    {notes.map((n) => (
      <a href={url(`/notes/${n.id}/`)} class="block rounded-2xl border border-line bg-surface p-5 no-underline text-fg hover:border-accent transition-colors">
        <div class="font-semibold">{n.data.title}</div>
        <p class="mt-1 text-sm text-muted">{n.data.description}</p>
        <div class="mt-2 flex gap-2 text-[11px] text-muted">
          {n.data.tags.map((t) => <span class="px-2 py-0.5 rounded-full bg-raised">{t}</span>)}
          <span class="ml-auto tabular-nums">{fmt(n.data.updated)}</span>
        </div>
      </a>
    ))}
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../site';
import { LEVELS, STAGES } from '../../data/grammar';
import { renderJa } from '../../../plugins/ja-text.mjs';
const all = (await getCollection('reading')).sort((a, b) => a.data.stage - b.data.stage || a.data.order - b.data.order);
const count = (stage: number) => all.filter((a) => a.data.stage === stage).length;
---
<Base title="读解" description="按语法单元编排的日语短文，每句都有读音、语法讲解和逐词注释。">
  <h1 class="text-xl font-semibold">读解</h1>
  <p class="text-muted text-sm mt-1 max-w-[42em]">按语法单元编排的短文。每句可以点读，点击句子里的词语就能直接听读音、看释义和讲解，下方还有逐句语法和逐词表。先把文章读一遍，再回看语法单元，效果最好。</p>
  <p class="text-xs text-muted mt-2 tabular-nums">已写 {all.length} 篇</p>

  {LEVELS.map((l) => {
    const stages = STAGES.filter((s) => s.level === l.id && count(s.n) > 0);
    if (stages.length === 0) return null;
    return (
      <section class="mt-10">
        <h2 class="text-lg font-semibold">{l.title}</h2>
        {stages.map((s) => (
          <div class="mt-5">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span class="text-xs text-muted tabular-nums">第 {s.n} 单元</span>
              <h3 class="text-base font-semibold">{s.title}</h3>
              <span class="text-xs text-muted">{count(s.n)} 篇</span>
            </div>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {all.filter((a) => a.data.stage === s.n).map((a) => (
                <a href={url(`/reading/${a.id}/`)} class="block rounded-2xl border border-line bg-surface p-4 no-underline text-fg hover:border-accent transition-colors">
                  <div class="flex items-center gap-2 text-xs text-muted"><span class="px-1.5 py-0.5 rounded bg-raised">{a.data.level}</span><span class="ml-auto tabular-nums">第 {a.data.order} 篇</span></div>
                  <div class="font-medium mt-1" set:html={renderJa(a.data.title)}></div>
                  <p class="text-sm text-muted mt-1">{a.data.desc}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    );
  })}
</Base>

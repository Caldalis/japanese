---
import Base from '../layouts/Base.astro';
import { site, url } from '../site';

// 首页字源示意：真实数据，不是装饰
const pairs = [
  { src: '安', kana: 'あ', kind: 'hira' }, { src: '加', kana: 'か', kind: 'hira' }, { src: '仁', kana: 'に', kind: 'hira' }, { src: '礼', kana: 'れ', kind: 'hira' },
  { src: '阿', kana: 'ア', kind: 'kata' }, { src: '八', kana: 'ハ', kind: 'kata' }, { src: '利', kana: 'リ', kind: 'kata' }, { src: '川', kana: 'ツ', kind: 'kata' },
];
const modules = [
  { title: '五十音', desc: '46 个清音的汉字字源、读音、浊音拗音长音、14 组易混字对比，加随机测验。', href: url('/kana/'), status: '可用', count: '6 个分区' },
  { title: '词汇', desc: 'N5 起步，按主题分组，闪卡加间隔重复，进度存在本机。', status: '规划中' },
  { title: '语法', desc: '按学习路线排列，从 〜は〜です 到形容词，每条讲透：规则表、例句朗读、中国人易错点、练一练。', href: url('/grammar/'), status: '可用', count: '3 个单元 10 条起步' },
  { title: '汉字对照', desc: '中日同形词的意思差异：手紙 是信，勉強 是学习，娘 是女儿。', status: '规划中' },
] as { title: string; desc: string; href?: string; status: string; count?: string }[];
---
<Base wide>
  <section class="pt-6 pb-10 md:pt-12 md:pb-14">
    <p class="text-sm text-muted tracking-wide">{site.nameJa}</p>
    <h1 class="mt-1 text-3xl md:text-5xl font-semibold leading-tight max-w-[18em]" style="text-wrap: balance">从五十音的汉字字源开始学日语</h1>
    <p class="mt-4 text-base md:text-lg text-muted max-w-[32em]">平假名是汉字草书，片假名是汉字偏旁。你已经认识全部原材料，剩下的只是把形和音绑起来。</p>
    <div class="mt-6 flex flex-wrap gap-2">
      <a class="btn primary" href={url('/kana/')}>开始学五十音</a>
      <a class="btn" href={url('/notes/how-to-learn-kana/')}>怎么练才快</a>
    </div>
  </section>

  <section aria-label="字源示意" class="grid grid-cols-4 md:grid-cols-8 gap-2">
    {pairs.map((p) => (
      <div class:list={['rounded-xl py-3 text-center ja leading-none', p.kind === 'hira' ? 'bg-hira-soft' : 'bg-kata-soft']}>
        <div class="text-2xl md:text-3xl">{p.src}</div>
        <div class="text-muted text-xs my-1">↓</div>
        <div class:list={['text-3xl md:text-4xl', p.kind === 'hira' ? 'text-hira' : 'text-kata']}>{p.kana}</div>
      </div>
    ))}
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">模块</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {modules.map((m) => {
        const Tag = m.href ? 'a' : 'div';
        return (
          <Tag href={m.href} class:list={['block rounded-2xl border p-5 no-underline text-fg transition-colors', m.href ? 'border-line bg-surface hover:border-accent' : 'border-dashed border-line opacity-70']}>
            <div class="flex items-center gap-2">
              <span class="font-semibold text-base">{m.title}</span>
              <span class:list={['ml-auto text-[11px] px-2 py-0.5 rounded-full', m.href ? 'bg-ok-soft text-ok' : 'bg-raised text-muted']}>{m.status}</span>
            </div>
            <p class="mt-2 text-sm text-muted">{m.desc}</p>
            {m.count && <p class="mt-2 text-xs text-hira">{m.count} →</p>}
          </Tag>
        );
      })}
    </div>
  </section>

  <section class="mt-12 max-w-[42em]">
    <h2 class="text-lg font-semibold">怎么用这个站</h2>
    <ul class="mt-3 space-y-2 text-sm text-muted list-disc pl-5">
      <li>手机打开，点任何假名就能听读音、看字源。加到主屏幕当 App 用。</li>
      <li>每天一轮<a class="text-hira underline underline-offset-2" href={url('/kana/drill/')}>随机测验</a>，错题单独重练。只看表是记不住的。</li>
      <li>内容都是 Markdown 和 JSON，<a class="text-hira underline underline-offset-2" href={site.repo} target="_blank" rel="noopener">在 GitHub 上</a>改一个文件就能更新。</li>
    </ul>
  </section>
</Base>

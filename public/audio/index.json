 "ebb3abce222bce8e": "日曜日は 家に います。",
 "ebbfac08a347cde1": "金曜日までに レポートを 出してください。",
 "ebc0ba725c6d03f8": "じゅうじ",
 "ebe59087dff9e5c2": "はち",
 "ecb7ce08b8116e28": "よえん",
 "ecbbf5b08c29033a": "とおい",
 "ed0e538fe3dfe493": "なんびき",
 "ed184e102b7beef0": "ぜんぜん",
 "ed5478908b081187": "猫を 一匹 飼っています。",
 "edadc08acb44c8fb": "シ",
 "edbfe19cc7f40139": "キャ、キュ、キョ",
 "ee03d3f900e2dea2": "授業は 午前 九時に 始まります。",
 "ee0939243a090a8a": "じゅうごにち",
 "ee2a05271ce2561f": "〜こ",
 "ee99bd4af8105d4a": "映画は 七時に 始まります。",
 "ee9b414742f7a4f4": "きょねん",
 "eebc4339cc88785f": "りゅうがくせい",
 "ef340a06be82568d": "椅子に 座ってください。",
 "ef41c43c2edea636": "ありますか",
 "ef8aae1c9ad1ae92": "私は 猫が 好きです。",
 "efcdfd469dd19a40": "ありがとうございます",
 "efedc0832095d4ec": "はたち",
 "f0481cf0a321721c": "やっつ",
 "f08f2368597a9ab8": "かばん",
 "f0ac5dd6cc0abab8": "まつ",
 "f0c1d5dd6afd198f": "これは いくらですか。",
 "f11eb7a4401f2d93": "五時までに 帰ります。",
 "f14a827dd5eb6bdd": "かれ",
 "f1a490f88174d936": "リャ、リュ、リョ",
 "f1b7f5bd6bb6bf10": "なんじ",
 "f1e7812720d49b4d": "〜まい",
 "f28a131bfd21a9e2": "高くないです",
 "f292c39b37501e61": "ななふん",
 "f2af4896d1bcc468": "かのじょ",
 "f2cb7928562a5084": "教室に 学生が います。",
 "f340792100a7a0c3": "誕生日は 何月ですか。",
 "f3541b71ab61681f": "ゾ",
 "f36969fa578dc0c9": "やすみ",
 "f376be177a54664e": "いちじ",
 "f37974a3f68d257a": "ふん",
 "f3925f56d90319b9": "いちおく",
 "f3d261c99ab0885f": "お名前",
 "f3e94bb5ab231583": "いい",
 "f437ee30cf9a6b03": "ごちそうさまでした。とても おいしかったです。",
 "f4a67d17b1772c63": "ジャ、ジュ、ジョ",
 "f4bb09282acb19b6": "あなたは 先生ですか。",
 "f4db1bfd60675ec4": "レストランで 晩ご飯を 食べます。",
 "f4e40b1f56127738": "やすみます",
 "f4fc2e3a01bdfa50": "ル",
 "f54ea3754d3cab0d": "ろく",
 "f54f55db31dfe199": "じゅっぴき",
 "f5717897f6966744": "みます",
 "f5866f8be0adcc1b": "ごめんなさい",
 "f59424ca8a9e2878": "ゲ",
 "f605e801e7dd81eb": "明日は 休みです。",
 "f696b41db418d52e": "〜のほうが",
 "f6d62f284a196448": "ケーキ",
 "f6e06ca5e7340099": "バスで 行きます",
 "f711d54122942911": "これ",
 "f714fb8bb991d5d0": "この 店は 安くて おいしいです。",
 "f740eed2d30a8bce": "京都は 静かな 町です。",
 "f75f93917327e595": "ナ",
 "f76f3d8f0f250794": "女の 人が 二人 います。",
 "f7848b68a2dbe38b": "ついたち",
 "f7c5b8cee97136fa": "時々 映画を 見ます。",
 "f8549ad7a3276345": "田中先生は 親切です。",
 "f8a183b793e17a35": "おととい 友達に 会いました。",
 "f9209a14c6b8bfff": "デ",
 "f9c5ddb3b5364bc7": "ときどき",
 "f9f1e3426e8e1a49": "のほうが",
 "f9f91b4b99f11fcc": "毎朝 コーヒーを 飲みます。",
 "fa0d56cab897b097": "家で食べます",
 "fa5631af82d9f8ea": "見る→見ます",
 "fa793783429365c1": "新聞",
 "fa9c8d4970487423": "田中さんは 親切です。",
 "fac99193acf95266": "サ、シ、ス、セ、ソ",
 "fb0bcff826f66f18": "きっぷ",
 "fb0bee616b8c0535": "あいます",
 "fbce61462ee439ad": "散歩",
 "fbfb41b706c47bdc": "何を 食べますか",
 "fc0b6117effb2b05": "ごひゃく",
 "fc0e20fe900c5574": "どなた",
 "fc2b013320dd853d": "ろっこ",
 "fc6357051ee673e0": "さんがい",
 "fcf277db9bcfd64c": "なんまい",
 "fcfb14dcefa21f19": "部屋が 広いです。",
 "fdb829b53874782a": "ねる",
 "fdc8c2f11bc26b0a": "晩ご飯は 七時です。",
 "fdeac27f18d836d3": "も",
 "fdfe6c97dcb175bf": "田中さんは 親切で 面白いです。",
 "fe100f50a172c043": "私は 毎日 日本語を 勉強します。",
 "fe1b24182c94810a": "二千二十六年です。",
 "fe2fe8473cebda2a": "明日 東京へ 行きます。",
 "ff1d55c6e07d522c": "この 映画は とても 面白いです。",
 "ff32fa4bd382b10c": "じゅっぽん",
 "ff439aca998fac79": "とうきょうから",
 "ff644d93590dee0a": "たべる",
 "ff7026c6cd03ff1b": "何が ありますか",
 "fff29021d969a084": "パンを 三つ 買いました。"
}
